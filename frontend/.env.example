# Non-secret configuration. VITE_* values are public; never put credentials or tokens in them.
# Include the API version prefix. Endpoints passed to apiClient are relative to this base.
VITE_API_BASE_URL=/api/v1
# Shared mode for Home, Map, Explorer and Details. Keep mock until live validation.
# API mode supports basic public Villages only; public catalogues/rich sections are unavailable.
VITE_VILLAGE_EXPLORER_MODE=mock
# To explicitly enable the verified public APIs, set the mode above to api.
# Server-side only: restart dev/preview after changing this target. No /api/v1 suffix.
DEV_API_PROXY_TARGET=http://127.0.0.1:8080
# Docker Compose alternative (host port 8081 -> app port 8080):
# DEV_API_PROXY_TARGET=http://127.0.0.1:8081
